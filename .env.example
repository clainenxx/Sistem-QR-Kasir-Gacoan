# Copy file ini jadi `.env` (jangan commit `.env` ke git — sudah ada
# di .gitignore) lalu isi nilainya masing-masing.
#
# SEMUA variabel di sini otomatis ke-bundle ke JS yang dikirim ke
# browser (prefix VITE_ wajib buat Vite). Karena itu:
#   - HANYA taruh key yang memang aman dilihat publik di sini.
#   - JANGAN PERNAH taruh Supabase service_role key atau Midtrans
#     Server Key di file ini — keduanya harus lewat
#     `supabase secrets set` (lihat README bagian "Deploy Edge
#     Functions"), bukan file .env frontend.

# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Midtrans Dashboard (Sandbox) > Settings > Access Keys > Client Key
# (yang diawali SB-Mid-client-, BUKAN Server Key)
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
